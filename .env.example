# Local mode is the default; no external account is required.
VITE_APP_MODE=local

# Supabase setup (leave blank during local testing).
# Apply the schema and link the owner first; see docs/CLOUD_SETUP.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional Cloudinary adapter; not needed for local photos.
# Current adapter requires an unsigned preset. The supplied ml_default is Signed;
# leave these blank until signing or a dedicated unsigned preset is configured.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
