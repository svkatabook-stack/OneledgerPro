# Local mode is the default; no external account is required.
VITE_APP_MODE=local

# Future Supabase setup (leave blank during local testing).
# Cloud authentication and SQL require follow-up work; see HANDOVER.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Legacy optional Cloudinary adapter; not needed for local photos.
# Cloudflare Images/R2 integration is pending, not implemented yet.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
