# Local mode is the default; no external account is required.
VITE_APP_MODE=local

# Supabase setup (leave blank during local testing).
# Apply the schema and link the owner first; see docs/CLOUD_SETUP.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudinary credentials belong in Supabase Edge Function secrets only.
# See docs/CLOUDINARY_SETUP.md; no VITE_CLOUDINARY_* variables are required.
